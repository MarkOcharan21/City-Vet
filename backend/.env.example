PORT=5000

# Database driver: "postgres" (Supabase) or "mysql" (local fallback).
# db.js chooses PostgreSQL automatically when DATABASE_URL_POOLER is a
# postgresql:// URL, so DB_TYPE only needs to be set for the MySQL fallback.
DB_TYPE=postgres

# Supabase connection strings.
#
# Prefer Supavisor over the direct host: many Supabase projects publish an AAAA
# record only, which is unreachable from IPv4-only networks. Use port 5432
# (session mode) rather than 6543 (transaction mode) because this app runs real
# multi-statement transactions via getConnection().
DATABASE_URL_POOLER=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SSL=true
DB_POOL_LIMIT=10

# MySQL fallback (only used when DATABASE_URL_POOLER is unset and DB_TYPE=mysql)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=pet_vet_system

JWT_SECRET=your_jwt_secret_key

# Email notifications (Gmail SMTP example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=City Vet <your-email@gmail.com>

FRONTEND_URL=http://localhost:5178
BACKEND_URL=http://localhost:5000