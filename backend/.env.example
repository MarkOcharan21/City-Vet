PORT=5000

# Database driver: "postgres" (Supabase) or "mysql" (local fallback).
# db.js chooses PostgreSQL automatically when DATABASE_URL_POOLER is a
# postgresql:// URL, so DB_TYPE only needs to be set for the MySQL fallback.
DB_TYPE=postgres

# Supabase connection strings.
#
# Prefer Supavisor over the direct host: many Supabase projects publish an AAAA
# record only, which is unreachable from IPv4-only networks. Use port 5432
# (session mode) rather than 6543 (transaction mode) because this app runs real
# multi-statement transactions via getConnection().
DATABASE_URL_POOLER=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SSL=true
DB_POOL_LIMIT=10

# MySQL fallback (only used when DATABASE_URL_POOLER is unset and DB_TYPE=mysql)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=pet_vet_system

JWT_SECRET=your_jwt_secret_key

# Email notifications (Gmail SMTP example — works locally, but Render
# cannot reach Gmail over SMTP, so production uses the Brevo HTTP API)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=City Vet <your-email@gmail.com>

# Brevo HTTP API (REQUIRED on Render): free at https://www.brevo.com —
# verify EMAIL_USER as a sender, create an SMTP API key, and set it here.
# When set, all mail goes through Brevo instead of SMTP.
BREVO_API_KEY=

FRONTEND_URL=http://localhost:5178
BACKEND_URL=http://localhost:5000

# Cloudinary (cloud file storage - REQUIRED for Render deployment)
# Get keys at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret